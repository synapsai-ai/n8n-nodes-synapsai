    {
      "name": "Format leads as text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const lead = item.json;\n  const title = lead.dealTitle || '(No title)';\n  const qualification = lead.qualified ? 'Qualified' : 'Not qualified';\n  const line = (i + 1) + '. [' + lead.origin + '] ' + title + ' · score ' + (lead.score ?? '-') + ' · ' + qualification + ' · ' + (lead.status ?? '-') + ' · ' + (lead.recordedAt ?? '').slice(0, 10);\n  return { json: { line, interest: lead.interest } };\n});"
      }
    }
  ],
